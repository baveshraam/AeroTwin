# Python
__pycache__/
*.pyc
.venv/
venv/
env/

# Models / weights (download or train; don't commit big binaries)
ml/models/
*.pt
*.onnx
*.engine

# Data the twin generates at runtime
*.db
*.sqlite
data/twin.db
data/audit_log.jsonl
data/runs/
data/raw/

# Downloaded/regenerable ML datasets + training run artifacts — re-fetch with
# ml/fetch_datasets.py / regenerate with ml/train.py instead of pushing
data/datasets/
runs/
ml/runs/
# ultralytics' own datasets_dir setting only takes effect from the NEXT process
# (it's cached at import time) -- a stray top-level datasets/ can appear on a
# fresh clone's first fetch/train invocation before that setting "sticks".
/datasets/

# Media is big — keep demo media in Google Drive, not git
*.mp4
*.mov

# Runtime logs
*.log

# OS / IDE
.DS_Store
.vscode/
.idea/

# Local Claude Code tool settings
.claude/

# Secrets — API keys must never be committed
roboflow-key-1
roboflow-publishable-api-key
*api-key*
*.key

# NGAFID dataset (5.6GB — fetch from zenodo.org/records/6624956, never commit)
data/ngafid/

# Vite dep-optimizer cache (regenerated on dev/build; the shipped app is frontend/dist)
.vite/
**/.vite/
node_modules/
